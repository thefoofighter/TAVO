<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>TAVO</RootNamespace>
    <AssemblyName>TAVO</AssemblyName>
    <ApplicationIcon>..\..\assets\tavo.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>TAVO</Product>
    <AssemblyTitle>TAVO - Taskbar App Version Overlay</AssemblyTitle>
    <Description>Version badges for Windows taskbar pins when several versions of one app are pinned.</Description>
    <Authors>Cathal McNally</Authors>
    <Copyright>Public domain (The Unlicense)</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\tavo.ico" LogicalName="TAVO.tavo.ico" />
    <InternalsVisibleTo Include="TAVO.Tests" />
  </ItemGroup>

</Project>
